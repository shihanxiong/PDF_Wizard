# OS and Editor files
.DS_Store

# Logs
*.log

# Wails / Go build output (binaries, plists, etc.). Wails expects build/appicon.png
# for the dock/taskbar icon — that file stays tracked (see negation below).
pdf_wizard/build/**
!pdf_wizard/build/appicon.png

# Node.js / Frontend
pdf_wizard/frontend/node_modules
pdf_wizard/frontend/dist

# Playwright test artifacts
pdf_wizard/frontend/playwright-report
pdf_wizard/frontend/test-results